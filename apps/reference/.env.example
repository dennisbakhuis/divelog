# Where the divelog server listens; the app proxies /api/v1 and /media to it.
DIVELOG_BACKEND_URL=http://localhost:8300
# Shown in the header, page titles and the Open Graph cards.
DIVELOG_SITE_NAME=divelog
# Whose log this is; also ends every page title unless DIVELOG_TITLE_SUFFIX is set.
DIVELOG_OWNER_NAME=Diver
# The public origin, for the sitemap, robots.txt and absolute Open Graph URLs.
DIVELOG_SITE_URL=http://localhost:5374
DIVELOG_TITLE_SUFFIX=
