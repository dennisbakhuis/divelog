{
  "name": "@divelog/kit",
  "version": "0.6.1",
  "description": "SvelteKit components, page routes and server helpers for a divelog server",
  "license": "AGPL-3.0-only",
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "svelte": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "scripts/og-fonts.mjs",
    "!dist/**/*.test.*",
    "!dist/**/*.spec.*",
    "!dist/**/__fixtures__",
    "!dist/og/fonts/*.ttf"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "svelte": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./core": {
      "types": "./dist/core/index.d.ts",
      "default": "./dist/core/index.js"
    },
    "./routes": {
      "types": "./dist/routes/index.d.ts",
      "svelte": "./dist/routes/index.js",
      "default": "./dist/routes/index.js"
    },
    "./server": {
      "types": "./dist/server/index.d.ts",
      "default": "./dist/server/index.js"
    },
    "./og": {
      "types": "./dist/og/index.d.ts",
      "default": "./dist/og/index.js"
    },
    "./widgets": {
      "types": "./dist/widgets/index.d.ts",
      "svelte": "./dist/widgets/index.js",
      "default": "./dist/widgets/index.js"
    },
    "./testing": {
      "types": "./dist/testing/index.d.ts",
      "default": "./dist/testing/index.js"
    },
    "./styles/tokens.css": "./dist/styles/tokens.css",
    "./styles/divelog.css": "./dist/styles/divelog.css",
    "./styles/maplibre.css": "./dist/styles/maplibre.css",
    "./package.json": "./package.json"
  },
  "scripts": {
    "dev": "vite dev",
    "build": "svelte-kit sync && svelte-package && publint",
    "prepare": "svelte-kit sync && svelte-package",
    "prepack": "pnpm build",
    "lint": "eslint --max-warnings 0 .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "types": "node scripts/api-types.mjs",
    "types:check": "node scripts/api-types.mjs --check",
    "og-fonts": "node scripts/og-fonts.mjs",
    "og-fonts:check": "node scripts/og-fonts.mjs --check"
  },
  "peerDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "@sveltejs/kit": "^2.61.0",
    "maplibre-gl": "^6.11.2",
    "svelte": "^5.55.0"
  },
  "peerDependenciesMeta": {
    "@resvg/resvg-js": {
      "optional": true
    },
    "maplibre-gl": {
      "optional": true
    }
  },
  "dependencies": {
    "@protomaps/basemaps": "^5.7.2",
    "@types/d3-geo": "^3.1.0",
    "animejs": "^4.5.0",
    "d3-geo": "^3.1.1",
    "minisearch": "^7.2.0",
    "pmtiles": "^4.5.0",
    "topojson-client": "^3.1.0",
    "world-atlas": "^2.0.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@resvg/resvg-js": "^2.6.2",
    "@sveltejs/adapter-node": "^5.5.7",
    "@sveltejs/kit": "^2.70.3",
    "@sveltejs/package": "^2.5.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.0",
    "@types/node": "^22.20.2",
    "@types/topojson-client": "^3.1.5",
    "@types/topojson-specification": "^1.0.5",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-svelte": "^3.17.1",
    "globals": "^17.6.0",
    "jsdom": "^29.1.1",
    "maplibre-gl": "^6.11.2",
    "openapi-typescript": "^7.13.0",
    "prettier": "^3.8.3",
    "prettier-plugin-svelte": "^3.5.1",
    "publint": "^0.3.25",
    "svelte": "^5.57.0",
    "svelte-check": "^4.7.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.59.4",
    "vite": "^8.3.0",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": ">=22"
  }
}
