# divelog-server configuration. Every variable is optional; the values below are the defaults
# unless marked "example". Copy to .env for local development (read from the working directory).

# ── Process ──
HOST=0.0.0.0
PORT=8000
# Comma-separated proxy addresses uvicorn trusts for X-Forwarded-* (uvicorn's own setting).
FORWARDED_ALLOW_IPS=127.0.0.1
# Proxies whose X-Forwarded-For the app itself honours (comma-separated, empty = none).
TRUSTED_PROXY_IPS=
DEBUG=false
# Reported by GET /api/v1/version; empty = the installed package version.
APP_VERSION=

# ── Data ──
# The personal log repository (a git checkout) and the server's own state (sessions, variants).
DATA_ROOT=/data/repo
STATE_DIR=/data/state
# Commit and push edits made through the admin API.
GIT_ENABLED=true
GIT_AUTHOR_NAME=divelog
# Empty: OWNER_EMAIL.
GIT_AUTHOR_EMAIL=
GIT_SSH_KEY_PATH=/run/secrets/deploy_key
# A read-only checkout of the divelog-sites commons, layered under the log. Empty: none, unless
# the log's divelog.yaml names one.
COMMONS_ROOT=
# Pull the commons together with the log.
COMMONS_GIT_ENABLED=false
# List the commons sites you never dived in the public site lists, region pages and region maps
# too (a logbook plus atlas). Off: they keep their own page but stay out of every public list.
PUBLIC_COMMONS_SITES=false
# Comma-separated region ids PUBLIC_COMMONS_SITES is limited to. Empty: every region.
PUBLIC_COMMONS_REGIONS=

# ── Instance ──
SITE_NAME=divelog
OWNER_NAME=Diver
# ISO-3 codes that do not count as abroad; consecutive dives abroad become derived trips.
# Empty: every dive is at home and only trips/*.md with dates group dives (example: NLD,DEU,BEL).
HOME_COUNTRIES=
# Templates of the sign-in mail; {site_name} and {owner_name} are filled in.
MAIL_SUBJECT=Sign in to {site_name}
MAIL_GREETING=Hi {owner_name},

# ── Sign-in ──
# The one address that may sign in (example: diver@example.org). Empty: nobody can.
OWNER_EMAIL=
# Public URL of the site; magic links point at <SITE_URL>/api/v1/auth/verify.
SITE_URL=http://localhost:5173
# Change this in production (example: output of `openssl rand -hex 32`). The default logs a
# warning at startup, and with COOKIE_SECURE=true the server refuses to start on it.
SESSION_SECRET=dev-only-session-secret-change-me-please
SESSION_COOKIE_NAME=divelog_session
SESSION_DAYS=30
# Minutes a mailed sign-in link works; raise it when mail delivery is slow.
MAGIC_LINK_MINUTES=2
COOKIE_SECURE=false

# ── Mail ──
BACKEND_SMTP_HOST=localhost
BACKEND_SMTP_PORT=1325
BACKEND_SMTP_USERNAME=
BACKEND_SMTP_PASSWORD=
BACKEND_SMTP_TLS=false
# Empty: OWNER_EMAIL.
BACKEND_SMTP_FROM=

# ── Media ──
# local (files under MEDIA_ROOT) or s3.
STORAGE_BACKEND=local
MEDIA_ROOT=/data/media
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=us-east-1
MAX_UPLOAD_BYTES=52428800

# ── CLI tools ──
# Server the `push` subcommands of sitemap-osm and stickmap talk to.
DIVELOG_API=http://localhost:8000
# Contact in the User-Agent sent to Overpass and Wikimedia (default: OWNER_EMAIL).
DIVELOG_CONTACT=
