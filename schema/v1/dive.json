{
  "$defs": {
    "BuddyNoteRecord": {
      "additionalProperties": true,
      "description": "A buddy's note on a dive: a short comment, a drawn signature, or both.\n\n``person`` is the id of one of the dive's people. ``strokes`` are polylines of integer\npoints in a 1000 x 400 box. ``public`` shows the note on the public dive page.",
      "properties": {
        "person": {
          "minLength": 1,
          "title": "Person",
          "type": "string"
        },
        "comment": {
          "anyOf": [
            {
              "maxLength": 200,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Comment"
        },
        "strokes": {
          "anyOf": [
            {
              "items": {
                "items": {
                  "maxItems": 2,
                  "minItems": 2,
                  "prefixItems": [
                    {
                      "type": "integer"
                    },
                    {
                      "type": "integer"
                    }
                  ],
                  "type": "array"
                },
                "type": "array"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Strokes"
        },
        "signed_at": {
          "format": "date-time",
          "title": "Signed At",
          "type": "string"
        },
        "public": {
          "default": true,
          "title": "Public",
          "type": "boolean"
        }
      },
      "required": [
        "person",
        "signed_at"
      ],
      "title": "BuddyNoteRecord",
      "type": "object"
    },
    "MediaRef": {
      "additionalProperties": true,
      "description": "A stored file attached to a dive, site, person or gear item.\n\n``key`` addresses the media storage; a ``repo:`` prefix points into the data repository\ninstead. ``variants`` names the rendered WebP sizes that exist for this file. ``licence``\n(an allowlisted id such as ``CC-BY-4.0``), ``author`` and ``source`` (a URL) credit a photo\ntaken by someone else; they stay unset on the owner's own files.",
      "properties": {
        "id": {
          "maxLength": 80,
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "key": {
          "maxLength": 300,
          "minLength": 1,
          "title": "Key",
          "type": "string"
        },
        "kind": {
          "default": "photo",
          "title": "Kind",
          "type": "string"
        },
        "mime": {
          "default": "application/octet-stream",
          "title": "Mime",
          "type": "string"
        },
        "bytes": {
          "default": 0,
          "title": "Bytes",
          "type": "integer"
        },
        "width": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Width"
        },
        "height": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Height"
        },
        "taken_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Taken At"
        },
        "caption": {
          "default": "",
          "title": "Caption",
          "type": "string"
        },
        "credit": {
          "default": "",
          "title": "Credit",
          "type": "string"
        },
        "sort": {
          "default": 0,
          "title": "Sort",
          "type": "integer"
        },
        "public": {
          "default": true,
          "title": "Public",
          "type": "boolean"
        },
        "variants": {
          "items": {
            "type": "string"
          },
          "title": "Variants",
          "type": "array"
        },
        "original_name": {
          "default": "",
          "title": "Original Name",
          "type": "string"
        },
        "licence": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Licence"
        },
        "author": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Author"
        },
        "source": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source"
        }
      },
      "required": [
        "id",
        "key"
      ],
      "title": "MediaRef",
      "type": "object"
    },
    "TankRecord": {
