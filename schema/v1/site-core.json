{
  "$defs": {
    "AccessPoint": {
      "additionalProperties": true,
      "properties": {
        "lat": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Lat"
        },
        "lon": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Lon"
        },
        "note": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Note"
        }
      },
      "title": "AccessPoint",
      "type": "object"
    },
    "ChangeEntry": {
      "additionalProperties": true,
      "description": "One line of a record's changelog: the revision it produced, when, by whom and why.",
      "properties": {
        "revision": {
          "minimum": 1,
          "title": "Revision",
          "type": "integer"
        },
        "date": {
          "format": "date",
          "title": "Date",
          "type": "string"
        },
        "author": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Author"
        },
        "note": {
          "title": "Note",
          "type": "string"
        }
      },
      "required": [
        "revision",
        "date",
        "note"
      ],
      "title": "ChangeEntry",
      "type": "object"
    },
    "MediaRef": {
      "additionalProperties": true,
      "description": "A stored file attached to a dive, site, person or gear item.\n\n``key`` addresses the media storage; a ``repo:`` prefix points into the data repository\ninstead. ``variants`` names the rendered WebP sizes that exist for this file.",
      "properties": {
        "id": {
          "maxLength": 80,
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "key": {
          "maxLength": 300,
          "minLength": 1,
          "title": "Key",
          "type": "string"
        },
        "kind": {
          "default": "photo",
          "title": "Kind",
          "type": "string"
        },
        "mime": {
          "default": "application/octet-stream",
          "title": "Mime",
          "type": "string"
        },
        "bytes": {
          "default": 0,
          "title": "Bytes",
          "type": "integer"
        },
        "width": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Width"
        },
        "height": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Height"
        },
        "taken_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Taken At"
        },
        "caption": {
          "default": "",
          "title": "Caption",
          "type": "string"
        },
        "credit": {
          "default": "",
          "title": "Credit",
          "type": "string"
        },
        "sort": {
          "default": 0,
          "title": "Sort",
          "type": "integer"
        },
        "public": {
          "default": true,
          "title": "Public",
          "type": "boolean"
        },
        "variants": {
          "items": {
            "type": "string"
          },
          "title": "Variants",
          "type": "array"
        },
        "original_name": {
          "default": "",
          "title": "Original Name",
          "type": "string"
        }
      },
      "required": [
        "id",
        "key"
      ],
      "title": "MediaRef",
      "type": "object"
    }
  },
  "additionalProperties": true,
  "description": "The objective description of a dive site: what a shared commons record carries.\n\n``verified`` and ``geo_source`` are provenance and therefore public. ``revision`` and\n``changelog`` version the record in its own file; only the server moves them.",
  "properties": {
    "site_id": {
      "minLength": 1,
      "title": "Site Id",
      "type": "string"
    },
    "name": {
      "title": "Name",
      "type": "string"
    },
    "full_name": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Full Name"
    },
    "short_name": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Short Name"
    },
    "aliases": {
      "items": {
        "type": "string"
      },
      "title": "Aliases",
      "type": "array"
    },
    "region": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Region"
    },
    "country": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Country"
    },
    "area": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Area"
    },
    "system": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "System"
    },
    "type": {
      "default": "sea",
      "title": "Type",
      "type": "string"
    },
    "section_vocabulary": {
      "items": {
        "type": "string"
      },
      "title": "Section Vocabulary",
      "type": "array"
    },
    "lat": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Lat"
    },
    "lon": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Lon"
    },
    "access": {
      "anyOf": [
        {
          "$ref": "#/$defs/AccessPoint"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "location_visibility": {
      "default": "exact",
      "enum": [
        "exact",
        "region_only"
      ],
      "title": "Location Visibility",
      "type": "string"
    },
    "water": {
      "anyOf": [
        {
          "enum": [
            "salt",
            "fresh",
            "brackish"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Water"
    },
    "halocline": {
      "default": false,
      "title": "Halocline",
      "type": "boolean"
    },
    "halocline_m": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Halocline M"
    },
    "summary": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Summary"
    },
    "maps": {
      "items": {
        "type": "string"
      },
      "title": "Maps",
      "type": "array"
    },
    "default_map": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Default Map"
    },
    "media": {
      "items": {
        "$ref": "#/$defs/MediaRef"
      },
      "title": "Media",
      "type": "array"
    },
    "sources": {
      "items": {
        "type": "string"
      },
      "title": "Sources",
      "type": "array"
    },
    "verified": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Verified"
    },
    "geo_source": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Geo Source"
    },
    "revision": {
      "default": 1,
      "minimum": 1,
      "title": "Revision",
      "type": "integer"
    },
    "changelog": {
      "items": {
        "$ref": "#/$defs/ChangeEntry"
      },
      "title": "Changelog",
      "type": "array"
    }
  },
  "required": [
    "site_id",
    "name"
  ],
  "title": "SiteCore",
  "type": "object"
}
